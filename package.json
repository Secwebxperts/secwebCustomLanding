{
  "name": "project-name",
  "version": "0.1.0",
  "private": true,
  "lint-staged": {
    "**/*.{ts,tsx,css}": "npm run format"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "sb:dev": "storybook dev -p 6006 --no-open -c ./src/lib/storybook --quiet",
    "sb:build": "storybook build -c ./src/lib/.storybook",
    "format": "prettier --write **/*.{ts,tsx,css} --config ./prettier.config.js",
    "prepare": "npx husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "motion": "^12.23.12",
    "next": "15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@storybook/addon-a11y": "^9.1.4",
    "@storybook/nextjs": "^9.1.4",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-storybook": "^9.1.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "storybook": "^9.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
